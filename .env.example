# Public Web entrypoint. The API is reachable through the Web reverse proxy.
VIBE_SEC_HTTP_PORT=8000

# Host directory containing projects to audit. The container sees it as /workspace.
# Projects are mounted read-only; VRTM snapshots and run state go to the named volume.
VIBE_SEC_PROJECTS_PATH=./projects

# Optional explicit CORS origins for a separately hosted frontend.
VIBE_SEC_CORS_ORIGINS=http://localhost:8000

# Do not put an LLM key here. Use compose.llm.yml with a secret file:
# VIBE_SEC_DEEPSEEK_API_KEY_FILE=C:/path/to/deepseek.key
